# ============================================================================
#  CTMS backend - environment variables (TEMPLATE)
#  ---------------------------------------------------------------------------
#  This file documents the environment variables read by the Spring Boot app.
#  Copy it to `.env` and fill in real values for your machine:
#
#      copy .env.example .env      # Windows
#      cp   .env.example .env      # macOS / Linux
#
#  !! NEVER commit the real `.env` file - it may contain secrets. !!
#  Only this placeholder template (`.env.example`) belongs in version control.
#  `.env` is listed in the repository `.gitignore`.
# ============================================================================

# JDBC connection URL for the ctms MySQL schema.
# The default already points at a local MySQL 8 instance.
CTMS_DB_URL=jdbc:mysql://localhost:3306/ctms?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true

# Database user name.
CTMS_DB_USERNAME=root

# Database password. NO DEFAULT - you must set this for the MySQL profile.
# Replace the placeholder below with your own password.
CTMS_DB_PASSWORD=changeme

# HTTP port the backend listens on.
CTMS_SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Alternatively, run without MySQL using the in-memory H2 profile:
#     .\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=h2"
# (no database credentials required; sample data is loaded automatically)
# ---------------------------------------------------------------------------
