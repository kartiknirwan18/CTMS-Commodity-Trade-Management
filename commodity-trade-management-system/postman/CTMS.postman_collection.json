              }
            }
          ]
        },
        {
          "name": "Create Commodity",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman Test Commodity {{$timestamp}}\",\"type\":\"OTHER\",\"unitOfMeasurement\":\"OTHER\",\"description\":\"Created by the Postman collection\",\"active\":true}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/commodities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "commodities"]
            },
            "description": "Create a commodity with a unique name (dynamic timestamp) and capture its id into {{commodityId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data && data.id) {",
                  "  pm.collectionVariables.set(\"commodityId\", data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Commodity By Id",
          "request": {
            "method": "GET",
            "header": [],
