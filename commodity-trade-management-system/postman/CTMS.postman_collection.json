            "body": {
              "mode": "raw",
              "raw": "{\"contractReference\":\"\",\"buyerName\":\"Vitol\",\"sellerName\":\"Trafigura\",\"commodityId\":{{commodityId}},\"contractQuantity\":5000,\"contractPrice\":76.25,\"contractDate\":\"2026-01-10\",\"deliveryDate\":\"2026-02-10\",\"deliveryLocation\":\"Rotterdam\",\"status\":\"DRAFT\",\"linkedTradeId\":null}",
