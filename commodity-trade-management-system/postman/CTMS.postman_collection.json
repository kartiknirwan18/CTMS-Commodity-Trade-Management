        {
          "name": "List Commodities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/commodities?q=&active=true&type=ENERGY",
              "host": ["{{baseUrl}}"],
              "path": ["api", "commodities"],
              "query": [
                { "key": "q", "value": "" },
                { "key": "active", "value": "true" },
                { "key": "type", "value": "ENERGY" }
              ]
            },
            "description": "List commodities with optional filters q / active / type."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
