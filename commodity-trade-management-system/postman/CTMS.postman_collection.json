{
  "info": {
    "_postman_id": "b8f0a1c2-4d3e-4f5a-9b6c-ctms00000001",
    "name": "CTMS - Commodity Trade Management System",
    "description": "Collection covering every CTMS endpoint (Health, Commodities, Trades, Contracts, Dashboard).\n\nSet the `baseUrl` environment variable (see the bundled `CTMS-local` environment), then run the folders in order: Health -> Commodities -> Trades -> Contracts -> Dashboard. Collection variables `commodityId`, `tradeId`, `contractId` and `tempCommodityId` are captured automatically by the create requests.\n\nNOTE: P&L values returned by this API are simplified estimates for demonstration purposes only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "commodityId", "value": "1", "type": "string" },
    { "key": "tradeId", "value": "1", "type": "string" },
    { "key": "contractId", "value": "1", "type": "string" },
    { "key": "tempCommodityId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Liveness probe. Expects status UP."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Application is UP\", function () {",
                  "  pm.expect(pm.response.json().status).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Commodities",
