            "description": "Creates a contract (blank reference is auto-generated). Captures the id into {{contractId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
