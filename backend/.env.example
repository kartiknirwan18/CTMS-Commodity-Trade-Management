# ---------------------------------------------------------------------------
# MultiStore backend - environment variables (placeholders only)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Comma separated list of allowed browser origins for CORS
CORS_ORIGIN=http://localhost:5173

# JWT - use a long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=multistore

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local zero-setup development (default, Prisma provider = "sqlite")
DATABASE_URL="file:./dev.db"

# Production / PostgreSQL: set `provider = "postgresql"` in
# backend/prisma/schema.prisma, then run:
#   npx prisma migrate dev --name switch_to_postgres
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/multistore?schema=public"

# ---------------------------------------------------------------------------
# Seed script defaults (development data only)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@multistore.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OWNER_PASSWORD=Owner@12345
SEED_CUSTOMER_PASSWORD=Customer@12345
