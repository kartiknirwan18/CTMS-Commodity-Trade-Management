# Frontend environment variables (placeholders only)
# Copy to `.env` when you need to override the defaults.

# Base path of the REST API. Keep '/api' to use the Vite dev proxy.
VITE_API_URL=/api

# Origin used to resolve relative upload URLs such as '/uploads/...'
# Leave empty in development (the Vite proxy handles it).
VITE_ASSET_ORIGIN=

# Where the Vite dev server proxies /api and /uploads during development.
VITE_PROXY_TARGET=http://localhost:5000
